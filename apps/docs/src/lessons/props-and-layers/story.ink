VAR lamp_lit = true

=== lamp_use ===
~ lamp_lit = not lamp_lit
{ lamp_lit:
    Wren: Better.
- else:
    Wren: Oh, look. Fireflies.
}
-> END

=== lamp_look ===
Wren: An old gas lamp, converted to something that hums.
-> END

=== pinwheel_look ===
Wren: A pinwheel. Someone's idea of a weather station.
-> END
