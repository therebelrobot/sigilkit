{
  "name": "sigilkit-monorepo",
  "private": true,
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/phaser-shim",
    "packages/sigilkit",
    "apps/demo",
    "apps/party"
  ],
  "scripts": {
    "dev": "npm run dev -w sigilkit-demo",
    "dev:party": "npm run dev -w sigilkit-party",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "rename": "tsx scripts/rename.ts",
    "release:patch": "npm -w sigilkit version patch -m \"chore: release v%s\" && git push && git push --tags",
    "release:minor": "npm -w sigilkit version minor -m \"chore: release v%s\" && git push && git push --tags",
    "release:major": "npm -w sigilkit version major -m \"chore: release v%s\" && git push && git push --tags",
    "release:tags": "git tag --sort=-v:refname | grep '^v'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}